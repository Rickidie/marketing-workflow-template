# Marketing Workflow — Environment Variables
# Copy this file to .env and fill in your values.
# cp .env.example .env
#
# NEVER commit .env to version control. It is already in .gitignore.

# =============================================================================
# Brand Identity
# =============================================================================

# Your brand's display name (used in prompts, reports, and content)
BRAND_NAME=Your Brand Name

# Your brand's public website URL (no trailing slash)
BRAND_URL=https://www.your-domain.com

# Legal entity name (used in formal content and CTA copy)
BRAND_LEGAL_NAME=Your Legal Entity Pte Ltd

# Parent company or holding group, if applicable (leave blank if standalone)
BRAND_PARENT_COMPANY=

# Former brand name if rebranded (leave blank if not applicable)
BRAND_PREDECESSOR=

# Registered business address
BRAND_ADDRESS=Your address here

# Email address of the marketing operator running this workflow
USER_EMAIL=you@your-domain.com

# =============================================================================
# Notion Integration
# =============================================================================
# Required for all agents that read or write to the marketing Notion workspace.
# Get your API key from: https://www.notion.so/profile/integrations

NOTION_API_KEY=secret_your_notion_integration_token_here

# Notion Database IDs — find these in the URL of each database view:
# https://www.notion.so/{workspace}/{DATABASE_ID}?v={view_id}

GEO_BRAND_TRACKING_DB_ID=your_geo_brand_tracking_database_id
WEBSITE_AUDIT_LOG_DB_ID=your_website_audit_log_database_id
KEYWORD_RESEARCH_DB_ID=your_keyword_research_database_id
COMPETITOR_INTELLIGENCE_DB_ID=your_competitor_intelligence_database_id
CONTENT_PERFORMANCE_DB_ID=your_content_performance_database_id
CONTENT_BRIEFS_DB_ID=your_content_briefs_database_id
CONTENT_CALENDAR_DB_ID=your_content_calendar_database_id
KEYWORD_SCORE_HISTORY_DB_ID=your_keyword_score_history_database_id

# =============================================================================
# Google / AI APIs
# =============================================================================

# Gemini API key — used by the nanobanana MCP server for image generation
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# Google Cloud / BigQuery (for GA4 analytics integration)
# =============================================================================
# Required only if you want the geo-intelligence-synthesizer to query GA4 data
# via BigQuery. Leave blank to skip analytics queries.

# GCP project ID where your GA4 BigQuery export lands
GCP_PROJECT_ID=your-gcp-project-id

# BigQuery dataset name for GA4 data (e.g. analytics_XXXXXXXXX)
BQ_DATASET=analytics_your_property_id

# GA4 property ID (numeric, found in GA4 Admin > Property Settings)
GA4_PROPERTY_ID=your_ga4_property_id

# Absolute path to your BigQuery service account JSON key file
# Generate from: GCP Console > IAM & Admin > Service Accounts
BIGQUERY_SA_PATH=/path/to/your/service-account-key.json
